# Glitterhoof, by Buck (Workshop 2889293511), brought into Supernatural 2.41 with his permission.
# The mesh, blend shapes, animations and textures are his. Supernatural 2.41 changed only:
#   - file names (spn_ prefix), so nothing collides if someone runs his mod beside this one;
#   - the shaders. His asked for "portrait_color_blend" and "portrait_hair_alpha" from a copy of the engine's portrait
#     shader his mod overrode (WORK-ORDER-2.41 §3.1 G4). Supernatural ships no shader, so the horse uses effects vanilla
#     1.20 itself uses with the same shader file: "portrait_attachment" (vanilla's plain attachment, e.g. the reins of
#     gfx/models/pets/horses/ep2_horse_01.asset) and "portrait_attachment_alpha_to_coverage" for the mane.
#   - 2.41 boot (3 Nov): his coat texture is a pale base his shader tinted through spn_horse_mask.dds, so without that
#     shader the horse rendered near-white. The coat is now pre-tinted, five ways (bay, chestnut, black, grey, palomino),
#     from his own diffuse and mask; the mane likewise. One pdxmesh and one entity per coat; the gene picks one per horse.

pdxmesh = {
	name = "spn_horse_bay_mesh"
	file = "spn_horse.mesh"
	scale = 1

	blend_shape = { id = "horse_gaunt"				type = "spn_horse_gaunt.mesh" }
	blend_shape = { id = "horse_muscular"			type = "spn_horse_muscular.mesh" }

	animation = { id = "horse_idle_1"				type = "spn_horse_idle_1.anim" }
	animation = { id = "horse_idle_2"				type = "spn_horse_idle_2.anim" }
	animation = { id = "horse_idle_3"				type = "spn_horse_idle_3.anim" }
	animation = { id = "horse_idle_4"				type = "spn_horse_idle_4.anim" }

	meshsettings = {
		name = "horse"
		index = 0
		texture_diffuse = "spn_horse_diffuse_bay.dds"
		texture_normal = "spn_horse_normal.dds"
		texture_specular = "spn_horse_properties.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	meshsettings = {
		name = "hair"
		index = 0
		texture_diffuse = "spn_hair_diffuse_bay.dds"
		texture_normal = "spn_hair_normal.dds"
		texture_specular = "spn_hair_properties.dds"
		shader = "portrait_attachment_alpha_to_coverage"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
}

entity = {
	name = "spn_horse_bay_entity"
	pdxmesh = "spn_horse_bay_mesh"
	get_state_from_parent = no

	attribute = { name = "bs_body_gaunt_1"		blend_shape = "horse_gaunt" }
	attribute = { name = "bs_body_fat_1"		blend_shape = "horse_muscular" }

	default_state = "idle_entry"

	state = { name = "idle_entry"	animation = "horse_idle_1" looping = no next_state = "idle" }
	state = { name = "idle"			animation = "horse_idle_1" chance = 10 looping = no next_state = "idle_entry" }
	state = { name = "idle"			animation = "horse_idle_2" chance = 1 looping = no next_state = "idle_entry" }
	state = { name = "idle"			animation = "horse_idle_3" chance = 1 looping = no next_state = "idle_entry" }
	state = { name = "idle"			animation = "horse_idle_4" chance = 1 looping = no next_state = "idle_entry" }
}

