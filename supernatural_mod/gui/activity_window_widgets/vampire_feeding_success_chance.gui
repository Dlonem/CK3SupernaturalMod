### Vampire Feeding Success Chance bar.
### Duplicated from vanilla hunt_success_chance.gui; repointed at our activity/variable/script value, marker recolored red.
hbox = {
	name = "vampire_feeding_success_chance"
	spacing = 5

	datacontext = "[ActivityWindow.GetActivity]"

	visible = "[EqualTo_string( ActivityType.GetKey(), 'vampire_feeding')]"

	text_single = {
		text = "vampire_feeding_success_bar"
		align = nobaseline
		max_width = 200
	}

	text_single = {
		text = "spn_vampire_feeding_success_pct"
		align = nobaseline
	}

	progressbar_standard = {
		layoutpolicy_horizontal = expanding
		size = { 200 30 }
		value = "[Activity.MakeScope.Var( 'vampire_feeding_success_chance' ).GetValue]"
		max = 100
		min = 0
		color = { 1.0 0.82 0.05 1 }

		using = Progressbar_Changed_Animation

		datacontext = "[GuiScope.SetRoot( Activity.MakeScope ).GetScriptValueBreakdown( 'vf_feeding_success_chance' )]"
		tooltip_visible = "[ValueBreakdown.HasTooltip]"

		tooltipwidget = {
			widget_value_breakdown_tooltip = {
				datacontext = "[GuiScope.SetRoot( Activity.MakeScope ).GetScriptValueBreakdown( 'vf_feeding_success_chance' )]"
			}
		}

		marker = {
			name = "current_value"
			widget = {
				icon = {
					size = { 25 25 }
					position = { -20 2 }
					texture = "gfx/interface/progressbars/progressbar_center_glow.dds"
					color = { 1 1 0.7 0.95 }
				}
			}
		}
	}
}
