### Supernatural Hunt tracking bar (2.35).
### Copy of vampire_feeding_success_chance.gui (itself vanilla hunt_success_chance.gui) with key, variable and script value swapped.
hbox = {
	name = "supernatural_hunt_success_chance"
	spacing = 5

	datacontext = "[ActivityWindow.GetActivity]"

	visible = "[EqualTo_string( ActivityType.GetKey(), 'supernatural_hunt')]"

	text_single = {
		text = "spn_hunt_success_bar"
		align = nobaseline
		max_width = 200
	}

	text_single = {
		text = "spn_hunt_success_pct"
		align = nobaseline
	}

	progressbar_standard = {
		layoutpolicy_horizontal = expanding
		size = { 200 30 }
		value = "[Activity.MakeScope.Var( 'spn_hunt_success_chance' ).GetValue]"
		max = 100
		min = 0
		color = { 0.75 0.75 0.85 1 }

		using = Progressbar_Changed_Animation

		datacontext = "[GuiScope.SetRoot( Activity.MakeScope ).GetScriptValueBreakdown( 'spn_hunt_success_chance_value' )]"
		tooltip_visible = "[ValueBreakdown.HasTooltip]"

		tooltipwidget = {
			widget_value_breakdown_tooltip = {
				datacontext = "[GuiScope.SetRoot( Activity.MakeScope ).GetScriptValueBreakdown( 'spn_hunt_success_chance_value' )]"
			}
		}

		marker = {
			name = "current_value"
			widget = {
				icon = {
					size = { 25 25 }
					position = { -20 2 }
					texture = "gfx/interface/progressbars/progressbar_center_glow.dds"
					color = { 1 1 0.7 0.95 }
				}
			}
		}
	}
}
