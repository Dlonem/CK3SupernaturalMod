# Supernatural 2.43 -- the inner voice. Used in event text as #spn_thirst ...#! and #spn_wolf ...#!
# One short line at most, and only where the creature in a vampire, werewolf or hybrid would speak up (Thomas, 23 Nov).
textformatting = {
	format = {
		name = spn_thirst
		format = "color:{0.82, 0.24, 0.24};italic"
	}
	format = {
		name = spn_wolf
		format = "color:{0.74, 0.80, 0.88};italic"
	}
}
