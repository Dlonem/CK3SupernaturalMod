vbox = {
	name = "event_window_widget_mage_duel_room1"
	#layoutpolicy_horizontal = expanding
	#layoutpolicy_vertical = expanding
	
	#datacontext = "[EventWindowWidget.GetScope.sScheme('scheme')]"
	#visible = "[Scheme.GetSchemeType.IsValid]"
	
	allow_outside = yes
	margin = { 5 5 }
	#margin_right = 50
	#margin = { 5 5 }
	spacing = 4
	datacontext = "[EventWindowWidget.GetScope.sCharacter('char1')]"
	visible = "[GreaterThan_int32( FixedPointToInt(Character.MakeScope.Var( 'md_show_room' ).GetValue ), '(int32)0' )]"
	#background = {
	##	#using = Background_Area_With_Header
	#	using = Background_Frame
	#}
	widget = {
		size = { 220 110 }
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 4
			background = {
				#using = Background_Frame
				using = Background_Area_Dark
				using = Background_Area_ExtraDark
			}
			hbox = {	
				text_single = {
					#parentanchor = top|center
					#position = { -50 -10 }
					fontsize = 15
					text = previous_round_title
					default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
					using = Font_Type_Flavor
					#max_width = 950
	
					alpha = 0
	
					state = {
						name = start
						trigger_on_create = yes
						delay = 0.2
						using = Animation_Curve_Default
						alpha = 1
						duration = 0.5
					}
				}
	
				expand = {}
			}
			hbox = {	
				text_multi = {
					name = "description"
					#minimumsize = { 470 -1 }
					#maximumsize = { 470 -1 }
					autoresize = yes
					margin = { 4 4 }
					text = previous_round_details
					align = left
					fontsize = 14
					fontsize_min = 10
				}
	
				expand = {}
			}
			hbox = {
				visible = "[LessThan_int32( FixedPointToInt(Character.MakeScope.Var( 'md_endurance_loss' ).GetValue ), '(int32)0' )]"	
				text_multi = {
					name = "description2"
					#minimumsize = { 470 -1 }
					#maximumsize = { 470 -1 }
					autoresize = yes
					margin = { 4 4 }
					text = previous_round_details2
					align = left
					fontsize = 14
					fontsize_min = 10
				}
	
				expand = {}
			}
			expand = {}
		}
	}
	expand = {}
}
