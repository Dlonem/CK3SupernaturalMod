hbox = {
	name = "event_window_widget_event_whunt_progress"
	layoutpolicy_horizontal = expanding
	margin = { 10 0 }
	datacontext = "[GetPlayer]"
	# Requires scope:event_chain_length saved as a value, should be the total number of events in this chain to show the counter for
	# Requires scope:event_chain_progress saved as a value, should be the current event in the chain that is being shown, prior events are considered done
	vbox = {
		name = "whatever"

		#background = {
		#	using = Background_Area_ExtraDark
		#}
		allow_outside = yes
		hbox = {
			name = "surviving_chance"
			#datacontext = "[EventWindowWidget.GetScope.sCharacter('char1')]"
			#layoutpolicy_horizontal = expanding
			background = {
				#using = Background_Frame
				#using = Background_Area_Dark
				using = Background_Area_ExtraDark
			}
			spacing = 5
			#margin = 10
			margin_bottom = 5
			text_single = {
				align = center|center
				fontsize = 15
				raw_text = surviving_chance_label
				default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
				using = Font_Type_Standard
				#max_width = 950
				margin = { 10 10 }
				alpha = 0
				tooltip = "surviving_chance_tooltip"
	
				state = {
					name = start
					trigger_on_create = yes
					delay = 0.2
					using = Animation_Curve_Default
					alpha = 1
					duration = 0.5
				}
			}
		}
		hbox = {
			name = "progress_entries"
			datamodel = "[EventWindowWidgetChainProgress.GetProgressEntries]"
			layoutpolicy_horizontal = expanding
			#margin = 5
			#spacing = 5
			background = {
				using = Background_Area
				margin_top = -23
				margin_right = -45
				margin_left = -30
				margin_bottom = -27
			}

			item = {
				container = {
					icon = {
						visible = "[EventChainProgressEntry.IsNotDone]"
						#texture = "gfx/interface/icons/alerts_character_interaction/frame_disabled.dds"
						texture = "gfx/interface/icons/alerts/_frame_red.dds"
						size = { 45 45 }
						framesize = { 144 144 }
						position = { 0 4 }
					}
					
					icon = {
						visible = "[EventChainProgressEntry.IsDoing]"
						texture = "gfx/interface/icons/alerts/action_whunt_progress.dds"
						size = { 70 70 }
						framesize = { 144 144 }
						frame = 1
						position = { -12 -7 }
					}

					icon = {
						visible = "[EventChainProgressEntry.IsDone]"
						#texture = "gfx/interface/icons/alerts_character_interaction/frame_disabled.dds"
						texture = "gfx/interface/icons/alerts/action_whunt_progress.dds"
						size = { 45 45 }
						framesize = { 144 144 }
						position = { 0 4 }
					}
				}
			}
		}
	}
}
