# Supernatural 2.40 boot 3 (TRAILS): the Supernatural Trails window, opened by the Trails button in the HUD column.
#
# Thomas, boot 3: "the way we want the Supernatural Trails to work is it should be the equivalent of a hunter trying to
# go to the supernatural hunt and see what's available. In a way, it's several less clicks." The Situations panel could
# not do that (it is built for participants and phases: "Participants in Region: 0", a phase with no end date). This is
# a plain list instead: every open trail, grouped Bloodied / Troubled / Rumoured, each with its county, what left it (when
# the viewer can tell), how many incidents are on record and the year it was last seen. A hunter gets a button that opens
# the Supernatural Hunt itself, whose planner pins the trails he can reach.
#
# Data: the button runs scripted gui spn_trails_fill_gui (zz_spn_240_trails_scripted_guis.txt), which fills six lists on
# the player (spn_trails_fill_view_effect, zz_spn_240_trails_effects.txt), then shows this window. That is vanilla's own
# pattern for a list a button opens: funeral_deceased_selection_button.gui fills GetPlayer's list 'funeral_activity_targets'
# with funeral_fill_available_targets_gui and funeral_deceased_selection_widget.gui shows it as a datamodel. Four lists per
# band, boot 4 (Thomas: "I shouldn't be able to know who it was left by ... if I'm not actively having a Trailsman hired"):
# "_s" his own trails, "_t" every trail when he employs a Trailsman, "_k" trails left by someone of his pack, coven or
# temple whom he knows to be one, "_u" the rest (decided in script, spn_trails_fill_row_effect), so no row needs a
# scripted gui to decide what to print. Left by and Last seen are printed only as those lists allow.
#
# Generated by tool/pkgs/Q9/gen_trails_window.py from gen_trails_window_head.txt (the six row lists are written out in full,
# plain vanilla widgets, no gui types of our own). Edit the generator, not this file.
#
# Every gui function here has a vanilla 1.20.1.2 usage:
#   GetVariableSystem.Exists / Clear            window_siege.gui:24/34, Witchcraft's window_mage_counc
#   GetPlayer.MakeScope.GetList( '...' )         activity_window_widgets/funeral_deceased_selection_widget.gui:62
#   IsDataModelEmpty( ... )                      window_activity_log.gui:49
#   datacontext = "[Scope.Title]"                window_situation_list.gui:1180 (coa_title_medium)
#   Title.MakeScope.Var( '...' )                 window_government_administration.gui:3241
#   Var( '...' ).GetFlagName + ObjectsEqual      shared/portraits.gui:2318
#   Var( '...' ).IsSet / .GetValue               window_situation_list.gui, shared/portraits.gui
#   GetActivityType( '...' ), CanPlanActivity / CanStartActivity( GetPlayer.Self ),
#   ToggleGameViewData( 'activity_list_detail_host_window', ActivityType.Self )
#                                                window_government_administration.gui:2094-2106 (host an examination)
#   GetPlayer.IsValid                            shared/cooltip.gui:3517
#   header_pattern (header_text, button_close), scrollbox (scrollbox_content, scrollbox_empty), Window_Movable,
#   Window_Background, Window_Decoration, Window_Margins, Animation_FadeIn_Quick / FadeOut_Quick
#                                                window_activity_log.gui:1-60
#   coa_title_small                              shared/coat_of_arms.gui:773
# The window is hidden with no player (observer): the lists live on the player, so there is nothing to show then.

window = {
	name = "spn_trails_window"
	parentanchor = center
	position = { 0 -20 }
	size = { 560 720 }
	layer = middle
	allow_outside = yes

	using = Window_Movable
	using = Window_Background
	using = Window_Decoration

	visible = "[And( GetVariableSystem.Exists( 'spn_trails_window_show' ), GetPlayer.IsValid )]"

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
	}

	vbox = {
		using = Window_Margins
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding

		header_pattern = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text"
			{
				text = "spn_trails_window_title"
			}
			blockoverride "button_close"
			{
				onclick = "[GetVariableSystem.Clear( 'spn_trails_window_show' )]"
			}
		}

		# What the list is, in two sentences.
		text_multi = {
			margin = { 10 6 }
			autoresize = yes
			max_width = 470
			text = "spn_trails_window_intro"
		}

		# Boot 4: the one line that ties the list to the Trailsman (Thomas: "interconnect the supernatural hunt, the
		# Trailsman and the Supernatural Trails button"). var:spn_trv_trailsman is set by the fill at each click.
		text_multi = {
			visible = "[GetPlayer.MakeScope.Var( 'spn_trv_trailsman' ).IsSet]"
			margin = { 10 2 }
			autoresize = yes
			max_width = 470
			text = "spn_trails_trailsman_yes"
		}
		text_multi = {
			visible = "[Not( GetPlayer.MakeScope.Var( 'spn_trv_trailsman' ).IsSet )]"
			margin = { 10 2 }
			autoresize = yes
			max_width = 470
			default_format = "#weak"
			text = "spn_trails_trailsman_no"
		}

		# A hunter rides from here: the Supernatural Hunt's own host window, whose planner pins the trails in his reach.
		hbox = {
			datacontext = "[GetActivityType( 'supernatural_hunt' )]"
			visible = "[ActivityType.CanPlanActivity( GetPlayer.Self )]"
			layoutpolicy_horizontal = expanding
			margin = { 10 4 }

			button_standard = {
				layoutpolicy_horizontal = expanding
				text = "spn_trails_plan_hunt"
				enabled = "[ActivityType.CanStartActivity( GetPlayer.Self )]"
				onclick = "[GetVariableSystem.Clear( 'spn_trails_window_show' )]"
				onclick = "[ToggleGameViewData( 'activity_list_detail_host_window', ActivityType.Self )]"
				tooltip = "spn_trails_plan_hunt_tt"
			}
		}

		# Everyone else: who can ride after a trail.
		text_multi = {
			datacontext = "[GetActivityType( 'supernatural_hunt' )]"
			visible = "[Not( ActivityType.CanPlanActivity( GetPlayer.Self ) )]"
			margin = { 10 4 }
			autoresize = yes
			max_width = 470
			default_format = "#weak"
			text = "spn_trails_not_a_hunter"
		}

		scrollbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			blockoverride "scrollbox_empty"
			{
				visible = "[And( And( And( And( IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'spn_trv_blood_s' ) ), IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'spn_trv_blood_t' ) ) ), And( IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'spn_trv_blood_k' ) ), IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'spn_trv_blood_u' ) ) ) ), And( And( IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'spn_trv_strong_s' ) ), IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'spn_trv_strong_t' ) ) ), And( IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'spn_trv_strong_k' ) ), IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'spn_trv_strong_u' ) ) ) ) ), And( And( IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'spn_trv_faint_s' ) ), IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'spn_trv_faint_t' ) ) ), And( IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'spn_trv_faint_k' ) ), IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'spn_trv_faint_u' ) ) ) ) )]"
				text = "spn_trails_none"
			}

			blockoverride "scrollbox_content"
			{
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 12

					# ---------------------------------------------------------------- Bloodied
					vbox = {
						visible = "[Or( Or( Not( IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'spn_trv_blood_s' ) ) ), Not( IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'spn_trv_blood_t' ) ) ) ), Or( Not( IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'spn_trv_blood_k' ) ) ), Not( IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'spn_trv_blood_u' ) ) ) ) )]"
						layoutpolicy_horizontal = expanding
						spacing = 4

						text_multi = {
							autoresize = yes
							max_width = 430
							margin = { 4 2 }
							text = "spn_trails_band_blood"
						}
						# his own trails: left by you, the year shown
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 4
							datamodel = "[GetPlayer.MakeScope.GetList( 'spn_trv_blood_s' )]"
							item = {
								widget = {
									datacontext = "[Scope.Title]"
									size = { 430 80 }
									background = {
										using = Background_Area_Dark
									}
									hbox = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										margin = { 8 4 }
										spacing = 10
										coa_title_small = {}
										vbox = {
											layoutpolicy_horizontal = expanding
											spacing = 2
											text_single = {
												layoutpolicy_horizontal = expanding
												max_width = 330
												text = "spn_trails_row_name"
												default_format = "#high"
											}
											hbox = {
												layoutpolicy_horizontal = expanding
												spacing = 14
												text_single = {
													text = "spn_trails_row_kind_self"
												}
												expand = {}
											}
											hbox = {
												layoutpolicy_horizontal = expanding
												spacing = 14
												text_single = {
													visible = "[Title.MakeScope.Var( 'spn_menace_count' ).IsSet]"
													text = "spn_trails_row_count"
												}
												text_single = {
													visible = "[Title.MakeScope.Var( 'spn_trail_seen_year' ).IsSet]"
													text = "spn_trails_row_seen"
												}
												text_single = {
													visible = "[Not( Title.MakeScope.Var( 'spn_trail_seen_year' ).IsSet )]"
													text = "spn_trails_row_seen_unknown"
												}
												expand = {}
											}
										}
									}
								}
							}
						}
						# a Trailsman reads them: the kind and the year shown
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 4
							datamodel = "[GetPlayer.MakeScope.GetList( 'spn_trv_blood_t' )]"
							item = {
								widget = {
									datacontext = "[Scope.Title]"
									size = { 430 80 }
