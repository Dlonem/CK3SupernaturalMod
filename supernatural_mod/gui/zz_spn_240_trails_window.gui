												}
												text_single = {
													visible = "[ObjectsEqual( Title.MakeScope.Var( 'spn_menace_kind' ).GetFlagName, 'werewolf' )]"
													text = "spn_trails_row_kind_werewolf"
												}
												text_single = {
													visible = "[ObjectsEqual( Title.MakeScope.Var( 'spn_menace_kind' ).GetFlagName, 'demon' )]"
													text = "spn_trails_row_kind_demon"
