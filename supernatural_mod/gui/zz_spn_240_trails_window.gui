												spacing = 14
												text_single = {
													visible = "[ObjectsEqual( Title.MakeScope.Var( 'spn_menace_kind' ).GetFlagName, 'vampire' )]"
													text = "spn_trails_row_kind_vampire"
												}
												text_single = {
													visible = "[ObjectsEqual( Title.MakeScope.Var( 'spn_menace_kind' ).GetFlagName, 'werewolf' )]"
													text = "spn_trails_row_kind_werewolf"
												}
												text_single = {
													visible = "[ObjectsEqual( Title.MakeScope.Var( 'spn_menace_kind' ).GetFlagName, 'demon' )]"
													text = "spn_trails_row_kind_demon"
												}
												text_single = {
													visible = "[ObjectsEqual( Title.MakeScope.Var( 'spn_menace_kind' ).GetFlagName, 'witch' )]"
													text = "spn_trails_row_kind_witch"
												}
												text_single = {
													visible = "[Not( Title.MakeScope.Var( 'spn_menace_kind' ).IsSet )]"
													text = "spn_trails_row_kind_unknown"
												}
												expand = {}
											}
											hbox = {
												layoutpolicy_horizontal = expanding
												spacing = 14
												text_single = {
													visible = "[Title.MakeScope.Var( 'spn_menace_count' ).IsSet]"
													text = "spn_trails_row_count"
												}
												text_single = {
													visible = "[Title.MakeScope.Var( 'spn_trail_seen_year' ).IsSet]"
													text = "spn_trails_row_seen"
												}
												text_single = {
													visible = "[Not( Title.MakeScope.Var( 'spn_trail_seen_year' ).IsSet )]"
													text = "spn_trails_row_seen_unknown"
												}
												expand = {}
											}
										}
									}
								}
							}
						}
