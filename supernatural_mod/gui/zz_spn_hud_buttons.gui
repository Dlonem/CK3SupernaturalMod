# Supernatural 2.38 -- the three HUD buttons (WORK-ORDER-2.38 §6). Each is a copy of Witchcraft's working council button
# (window_high_council.gui, window_mage_counc_tab_button1) with six things changed: name, position, visible, and inside
# button_hud_character_bar the onclick, tooltip and highlight_icon texture. There is no deep link to one story, so each
# opens the Situations window, where the pack, chapter or coven is listed.

container = {
	name = "spn_hud_pack_button"
	parentanchor = bottom|left
	position = { -5 -500 }
	alwaystransparent = no
	layer = bottom
	#visible = "[GetGlobalVariable( 'mc_has_been_formed' ).IsSet]"
	visible = "[GetPlayer.MakeScope.Var( 'spn_pack' ).IsSet]"
	
	button_hud_character_bar = {
		name = "mage_counc_button"
		datacontext = "[GetPlayer.GetFaith]"
		parentanchor = left
		enabled = yes
		#onclick = "[OpenGameViewData( 'faith', GetPlayer.GetFaith.GetID )]"
		#onclick = "[ToggleGameViewData( 'faith', GetPlayer.GetFaith.GetID )]"
		onclick = "[OpenGameView( 'situations' )]"
		#onclick = "[GetScriptedGui('load_mc_variables').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

		using = tooltip_es

		tooltip = spn_hud_pack_tt

		highlight_icon = {
			texture = "gfx/interface/icons/spn_hud/spn_hud_pack.dds"
			size = { 40 40 }
			position = { 0 1 }
			parentanchor = center

			glow = {
				color = { 0 0 0 0.8 }
				glow_radius = 3
				using = Glow_Standard
			}
		}
	}
}

