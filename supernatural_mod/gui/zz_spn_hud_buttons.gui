# 2.40 (WORK-ORDER-2.40 A12): the Gnostic Council's slot, held while either council button shows (the OR of the visible
# expressions of window_mage_counc_tab_button0 and _button1, window_high_council.gui), so the Order sits right above it.
widget = {
	name = "spn_hud_council_slot"
	size = { 50 52 }
	alwaystransparent = yes
	visible = "[Or( Or( And( Not( GetGlobalVariable( 'spn_order_council_ours' ).IsSet ), Or( GetPlayer.HasTrait( GetTrait( 'archmage' ) ), GetPlayer.HasTrait( GetTrait( 'true_witch' ) ) ) ), GetPlayer.MakeScope.Var( 'spn_order_member' ).IsSet ), GetGlobalVariable( 'mc_revealed' ).IsSet )]"
}

}
